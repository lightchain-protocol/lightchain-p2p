<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata for the Flatpak build.

  Flatpak is a self-build path, not a store channel: nothing is published to
  Flathub, because an install managed by a store cannot receive the
  peer-to-peer updates this application is built around. See
  docs/decisions/0007-flatpak-snap.md.

  The visible name is "Lightchain", matching the shipped window title, while
  the id stays ai.lightchain.Hub to match the flatpak maker in forge.config.js.
-->
<component type="desktop-application">
  <id>ai.lightchain.Hub</id>

  <name>Lightchain</name>
  <summary>Peer-to-peer rooms and paid AI inference</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>

  <developer id="ai.lightchain">
    <name>Lightchain</name>
  </developer>

  <content_rating type="oars-1.1" />

  <url type="homepage">https://lightchain.ai</url>
  <url type="help">https://github.com/lightchain-protocol/lightchain-p2p/issues/new/choose</url>
  <url type="bugtracker">https://github.com/lightchain-protocol/lightchain-p2p/issues</url>

  <!--
    The design-final captures kept in the repository, served raw. Replace with
    screenshots captured from a running release if store presence is ever
    revisited. apps/chat/assets/flatpak-screenshot.png is a template leftover
    ("Hello Pear v1.0.0") and is deliberately not used.
  -->
  <screenshots>
    <screenshot type="default">
      <caption>A room that keeps working while its creator is offline</caption>
      <image type="source">https://raw.githubusercontent.com/lightchain-protocol/lightchain-p2p/main/docs/design/after/final/dark-collapsed.png</image>
    </screenshot>
    <screenshot>
      <caption>The same rooms in a narrow window</caption>
      <image type="source">https://raw.githubusercontent.com/lightchain-protocol/lightchain-p2p/main/docs/design/after/final/dark-narrow-chat.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release date="2026-08-18" version="0.1.0" />
  </releases>

  <recommends>
    <display_length compare="ge">600</display_length>
  </recommends>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <description>
    <p>
      Rooms between people that keep working when whoever created them is offline, and paid
      inference from models on the Lightchain network. Keys are generated on your machine and
      never leave it.
    </p>
    <ul>
      <li>Encrypted multi-writer rooms over Hyperswarm, joined by an invite that carries no room key</li>
      <li>Prompts encrypted to the worker that answers them, and answers checked against its signature</li>
      <li>A wallet that is also your identity, backed up as twelve words</li>
      <li>Peer-to-peer over-the-air updates</li>
    </ul>
    <p>
      Note: a Flatpak install is managed by Flatpak, not by the application's own update
      channel. It is not expected to update itself — updating means installing a newer build.
    </p>
  </description>

  <launchable type="desktop-id">ai.lightchain.Hub.desktop</launchable>
</component>
