{
  "name": "lightchain-p2p",
  "version": "0.1.0",
  "private": true,
  "description": "Peer-to-peer infrastructure for Lightchain AI: model delivery, artifact availability, worker supervisor, and chat client",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "make": "node scripts/make.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check . && node scripts/check-bom.mjs"
  },
  "devDependencies": {
    "blind-peer": "^3.13.3",
    "corestore": "^7.12.0",
    "hypercore-id-encoding": "^1.3.0",
    "hyperswarm": "^4.17.0",
    "prettier": "^3.9.6",
    "rocksdb-native": "^3.17.4",
    "turbo": "^2.10.10",
    "typescript": "^5.9.3"
  }
}
