{
  "name": "lightchain-p2p",
  "version": "0.1.0",
  "private": true,
  "description": "Peer-to-peer infrastructure for Lightchain AI: model delivery, artifact availability, worker supervisor, and chat client",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "make": "node scripts/make.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.10",
    "typescript": "^5.9.3"
  }
}
